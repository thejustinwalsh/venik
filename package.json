{
  "name": "venik",
  "version": "1.0.0",
  "description": "Layout engine for JavaScript games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koteelok/venik.git"
  },
  "homepage": "https://koteelok.github.io/venik/",
  "bugs": {
    "url": "https://github.com/koteelok/venik/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "fuzz": "vitest run fuzz",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
