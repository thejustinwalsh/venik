---
import Base from "../layouts/Base.astro";
import { Code } from "astro:components";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const sample = `import { Node, Edge, Justify, Align, Direction } from "venik";

const hud = new Node();
hud.setPadding(Edge.All, 16);
hud.setJustifyContent(Justify.SpaceBetween);
hud.setAlignItems(Align.FlexEnd);

const healthBar = new Node();
healthBar.setWidth("25%");
healthBar.setHeight(24);
hud.insertChild(healthBar, 0);

// Runs every frame. A clean tree returns immediately;
// a dirty one revisits only dirty branches.
function frame(w: number, h: number) {
  hud.setWidth(w);
  hud.setHeight(h);
  hud.calculateLayout(undefined, undefined, Direction.LTR);

  drawRect(
    healthBar.getComputedLeft(),
    healthBar.getComputedTop(),
    healthBar.getComputedWidth(),
    healthBar.getComputedHeight(),
  );
}`;

// Numbers come from README.md ("Motivation"), µs per frame.
const bench = [
  { label: "One leaf changes", yaga: 25, flexily: 200, yoga: 260 },
  { label: "50 leaves change", yaga: 510, flexily: 730, yoga: 1660 },
  { label: "Full relayout", yaga: 1000, flexily: 1050, yoga: 3190 },
];

// Garbage per frame (JS heap) from README.md, KB.
const garbage = [
  { label: "One leaf changes", yaga: 1.0, flexily: 16, yoga: 1.0 },
  { label: "50 leaves change", yaga: 15, flexily: 77, yoga: 22 },
  { label: "Full relayout", yaga: 65, flexily: 181, yoga: 2.1 },
];

// Bundle sizes from README.md, KB.
const bundle = [
  { label: "Minified", yaga: 72, flexily: 71, yoga: 125 },
  { label: "Minified + gzip", yaga: 19, flexily: 22, yoga: 50 },
];
---

<Base title="Home">
  <div class="page">
    <section class="hero">
      <div class="logo" aria-hidden="true">🧹</div>
      <h1>venik</h1>
      <p class="tagline">Flexbox layout engine built for JavaScript games.</p>
      <div class="cta">
        <a class="button primary" href={`${base}/docs/`}>Read the docs</a>
        <a class="button" href={`${base}/examples/`}>Try the examples</a>
        <a class="button" href="https://github.com/koteelok/venik">GitHub</a>
        <code class="install">npm install venik</code>
      </div>
    </section>

    <section class="split">
      <div class="code">
        <h2>✨ Simple API</h2>
        <Code
          code={sample}
          lang="ts"
          themes={{ light: "github-light", dark: "github-dark" }}
          defaultColor={false}
        />
      </div>
      <div class="bench">
        <h2>⚡ Best-in-class speed</h2>
        <table>
          <thead>
            <tr><th></th><th>venik</th><th>flexily</th><th>yoga-layout</th></tr>
          </thead>
          <tbody>
            {bench.map((row) => {
              const best = Math.min(row.yaga, row.flexily, row.yoga);
              const cell = (v: number) => <td class={v === best ? "best" : undefined}>{v}µs</td>;
              return (
                <tr>
                  <th scope="row">{row.label}</th>
                  {cell(row.yaga)}
                  {cell(row.flexily)}
                  {cell(row.yoga)}
                </tr>
              );
            })}
          </tbody>
        </table>
        <h2 class="spaced">♻️ Small runtime footprint</h2>
        <table>
          <thead>
            <tr><th></th><th>venik</th><th>flexily</th><th>yoga-layout</th></tr>
          </thead>
          <tbody>
            {garbage.map((row) => {
              const best = Math.min(row.yaga, row.flexily, row.yoga);
              const cell = (v: number) => <td class={v === best ? "best" : undefined}>{v} KB</td>;
              return (
                <tr>
                  <th scope="row">{row.label}</th>
                  {cell(row.yaga)}
                  {cell(row.flexily)}
                  {cell(row.yoga)}
                </tr>
              );
            })}
          </tbody>
        </table>
        <h2 class="spaced">📦 Small bundle size</h2>
        <table>
          <thead>
            <tr><th></th><th>venik</th><th>flexily</th><th>yoga-layout</th></tr>
          </thead>
          <tbody>
            {bundle.map((row) => {
              const best = Math.min(row.yaga, row.flexily, row.yoga);
              const cell = (v: number) => <td class={v === best ? "best" : undefined}>{v} KB</td>;
              return (
                <tr>
                  <th scope="row">{row.label}</th>
                  {cell(row.yaga)}
                  {cell(row.flexily)}
                  {cell(row.yoga)}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

  </div>
</Base>

<style>
  .page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px 40px;
  }
  h2 {
    font-size: 22px;
    margin: 0 0 12px;
  }
  .bench h2 {
    margin: 0;
  }
  h2.spaced {
    padding-top: 32px;
  }

  .hero {
    text-align: center;
    padding: 72px 0 56px;
  }
  .hero .logo {
    font-size: 96px;
    line-height: 1;
    margin-bottom: 8px;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.18));
  }
  .hero h1 {
    font-size: 48px;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .tagline {
    font-size: 22px;
    margin: 0 0 28px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .button {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }
  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .install {
    padding: 10px 14px;
    border: 1px dashed var(--border);
    border-radius: 8px;
    font-size: 14px;
    user-select: all;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 32px;
    align-items: start;
    margin-bottom: 56px;
  }
  @media (max-width: 800px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .split :global(pre.astro-code) {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel) !important;
    font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .split :global(pre.astro-code span) {
    color: var(--shiki-light);
  }
  @media (prefers-color-scheme: dark) {
    .split :global(pre.astro-code span) {
      color: var(--shiki-dark);
    }
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: right;
    padding: 8px 6px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th[scope="row"] {
    text-align: left;
    font-weight: 500;
    white-space: normal;
  }
  thead th {
    color: var(--muted);
    font-weight: 500;
  }
  td.best {
    font-weight: 700;
    color: var(--accent);
  }
</style>
