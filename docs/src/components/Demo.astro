---
/**
 * A small live playground for the docs: an editable tree on the left in the
 * examples page's JSX dialect, the laid out boxes on the right. Every
 * instance on a page is wired up by the script below.
 */
interface Props {
  code: string;
  /** Minimum height of the panes in pixels; the editor grows to fit its code. */
  minHeight?: number;
}
const { code, minHeight = 220 } = Astro.props;
import "../lib/resize.css";
---

<div class="demo" style={`--demo-min-height: ${minHeight}px`}>
  <div class="editor">
    <pre class="hl" aria-hidden="true"><code></code></pre>
    <textarea spellcheck="false" wrap="off" autocomplete="off" autocapitalize="off" aria-label="Layout source" set:text={code.trim()} />
    <div class="tweak" hidden>
      <span class="key"></span>
      <select class="unit" aria-label="Unit">
        <option value="px">px</option>
        <option value="%">%</option>
        <option value="auto">auto</option>
      </select>
      <input type="range" aria-label="Value" />
      <input type="number" aria-label="Value" />
      <select class="options" aria-label="Value"></select>
    </div>
  </div>
  <div class="preview">
    <canvas></canvas>
    <button type="button" class="sizer-handle" aria-label="Resize the root: drag, or arrow keys (Shift for 10)"></button>
  </div>
  <div class="status">
    <span class="status-text"></span>
    <span class="sizer-tools">
      <button type="button" class="sizer-fit" title="Size the root to the preview pane and follow it">Fit</button>
      <button type="button" class="sizer-fill" title="Fill the viewport; the root tracks its size">Fill</button>
      <button type="button" class="sizer-reset" title="Back to the example's own size">Reset</button>
    </span>
  </div>
</div>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    margin: 0 0 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
  }
  @media (max-width: 700px) {
    .demo {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
    }
  }
  .editor {
    position: relative;
    min-height: var(--demo-min-height);
    border-right: 1px solid var(--border);
    font: 12.5px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (max-width: 700px) {
    .editor {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
  /* The highlighted copy sits in normal flow and sizes the pane to the code;
     the textarea is laid over it, so the whole example is always visible. */
  .editor pre,
  .editor textarea {
    margin: 0;
    padding: 12px 14px;
    font: inherit;
    white-space: pre;
    overflow-wrap: normal;
    tab-size: 4;
    overflow: auto;
    border: 0;
    border-radius: 0;
    background: transparent !important;
  }
  .editor pre {
    pointer-events: none;
    overflow: hidden;
    min-height: var(--demo-min-height);
  }
  .editor textarea {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: transparent;
    caret-color: var(--fg);
    outline: 0;
    resize: none;
  }
  .editor textarea::selection {
    background: rgba(128, 128, 128, 0.35);
  }
  .editor :global(.line) {
    display: block;
    min-height: 1lh;
    margin: 0 -14px;
    padding: 0 14px;
  }
  .editor :global(.line.hot) {
    background: var(--hot);
  }
  .editor :global(.tk-tag) { color: var(--tk-tag); }
  .editor :global(.tk-attr) { color: var(--tk-attr); }
  .editor :global(.tk-key) { color: var(--tk-key); }
  .editor :global(.tk-number) { color: var(--tk-number); }
  .editor :global(.tk-string) { color: var(--tk-string); }
  .editor :global(.tk-comment) { color: var(--tk-comment); font-style: italic; }
  .editor :global(.tk-punct) { color: var(--tk-punct); }
  .tweak {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: nowrap;
  }
  .tweak[hidden] {
    display: none;
  }
  .tweak .key {
    color: var(--tk-key);
  }
  .tweak input[type="range"] {
    width: 160px;
    margin: 0;
    border: 0;
    padding: 0;
    background: transparent;
  }
  .tweak input[type="number"] {
    width: 64px;
  }
  .tweak input,
  .tweak select {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 4px;
  }
  /* Fill: the whole demo over the viewport, editor and preview filling it. */
  .demo.is-fill {
    position: fixed;
    inset: 0;
    z-index: 1000;
    margin: 0;
    border: 0;
    border-radius: 0;
    grid-template-rows: minmax(0, 1fr) auto;
  }
  @media (max-width: 700px) {
    .demo.is-fill {
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) auto;
    }
  }
  .demo.is-fill .editor,
  .demo.is-fill .preview {
    min-height: 0;
  }
  .demo.is-fill .editor pre {
    position: absolute;
    inset: 0;
    min-height: 0;
  }
  .preview {
    position: relative;
    /* The row is sized by the editor and min-height, never by the drawn root. */
    contain: size;
    min-height: var(--demo-min-height);
    overflow: auto;
    padding: 16px;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .preview canvas {
    display: block;
  }
  .status {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 8px 4px 14px;
    border-top: 1px solid var(--border);
    font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--muted);
    min-height: 29px;
    white-space: pre-wrap;
  }
  .status.error {
    color: var(--error);
  }
</style>

<script>
  import { Direction, Node } from "venik";
  import { highlight, LineIndex, parse, ParseError, type Element as SourceElement, type StyleEntry } from "../lib/jsx.ts";
  import { applyStyle, StyleError, styleSpec, type StyleSpec } from "../lib/style.ts";
  import { Sizer } from "../lib/resize.ts";

  type Box = { node: Node; depth: number; lines: number[]; x: number; y: number; width: number; height: number };

  function mount(demo: HTMLElement): void {
    const editor = demo.querySelector<HTMLTextAreaElement>("textarea")!;
    const code = demo.querySelector<HTMLElement>("pre code")!;
    const preview = demo.querySelector<HTMLElement>(".preview")!;
    const stage = demo.querySelector<HTMLCanvasElement>("canvas")!;
    const status = demo.querySelector<HTMLElement>(".status")!;
    const statusText = demo.querySelector<HTMLElement>(".status-text")!;
    const ctx = stage.getContext("2d")!;
    const tweak = demo.querySelector<HTMLElement>(".tweak")!;
    const tweakKey = tweak.querySelector<HTMLElement>(".key")!;
    const tweakUnit = tweak.querySelector<HTMLSelectElement>(".unit")!;
    const tweakRange = tweak.querySelector<HTMLInputElement>('input[type="range"]')!;
    const tweakNumber = tweak.querySelector<HTMLInputElement>('input[type="number"]')!;
    const tweakOptions = tweak.querySelector<HTMLSelectElement>(".options")!;

    let boxes: Box[] = [];
    /** The last successful parse, for the caret-driven controls. */
    let parsedRoot: SourceElement | null = null;
    let lineIndex = new LineIndex("");
    let boxOf = new Map<Node, Box>();
    let hot: Box | null = null;
    let rootSize = { width: 0, height: 0 };
    let stale = false;
    let scale = 1;
    let summary = "";

    function build(source: SourceElement, depth: number, out: Box[], lines: LineIndex): Node {
      const node = new Node();
      for (const entry of source.style) {
        try {
          applyStyle(node, entry.key, entry.value);
        } catch (error) {
          if (error instanceof StyleError) throw new ParseError(error.message, entry.span.start, []);
          throw error;
        }
      }
      const ownLines = lines.linesOf(source.open);
      if (source.close !== null) ownLines.push(...lines.linesOf(source.close));
      out.push({ node, depth, lines: ownLines, x: 0, y: 0, width: 0, height: 0 });
      source.children.forEach((child, index) => node.insertChild(build(child, depth + 1, out, lines), index));
      return node;
    }

    function place(box: Box, originX: number, originY: number): void {
      const { node } = box;
      box.x = originX + node.getComputedLeft();
      box.y = originY + node.getComputedTop();
      box.width = node.getComputedWidth();
      box.height = node.getComputedHeight();
      for (const child of node.getChildren()) {
        const childBox = boxOf.get(child);
        if (childBox !== undefined) place(childBox, box.x, box.y);
      }
    }

    function draw(): void {
      const style = getComputedStyle(preview);
      const availableWidth = preview.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      const availableHeight = preview.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
      scale = Math.min(1, availableWidth / Math.max(1, rootSize.width), availableHeight / Math.max(1, rootSize.height));
      const cssWidth = Math.ceil(rootSize.width * scale);
      const cssHeight = Math.ceil(rootSize.height * scale);
      const dpr = window.devicePixelRatio || 1;
      const width = Math.max(1, Math.round(cssWidth * dpr));
      const height = Math.max(1, Math.round(cssHeight * dpr));
      if (stage.width !== width || stage.height !== height) {
        stage.style.width = `${cssWidth}px`;
        stage.style.height = `${cssHeight}px`;
        stage.width = width;
        stage.height = height;
      }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
      ctx.clearRect(0, 0, rootSize.width, rootSize.height);
      ctx.globalAlpha = stale ? 0.5 : 1;
      for (const box of boxes) {
        const hue = (200 + box.depth * 47) % 360;
        ctx.fillStyle = `hsl(${hue} 70% 55% / 0.25)`;
        ctx.fillRect(box.x, box.y, box.width, box.height);
        ctx.strokeStyle = `hsl(${hue} 70% 45%)`;
        ctx.lineWidth = 1 / scale;
        const inset = 0.5 / scale;
        ctx.strokeRect(box.x + inset, box.y + inset, Math.max(0, box.width - 2 * inset), Math.max(0, box.height - 2 * inset));
      }
      if (hot !== null) {
        ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#0969da";
        ctx.lineWidth = 2 / scale;
        const gap = 2 / scale;
        ctx.strokeRect(hot.x - gap, hot.y - gap, hot.width + 2 * gap, hot.height + 2 * gap);
      }
      ctx.globalAlpha = 1;
      sizer.place();
    }

    function boxAt(cssX: number, cssY: number): Box | null {
      const x = cssX / scale;
      const y = cssY / scale;
      let found: Box | null = null;
      for (const box of boxes) {
        if (x >= box.x && x <= box.x + box.width && y >= box.y && y <= box.y + box.height) found = box;
      }
      return found;
    }

    function setHot(box: Box | null): void {
      if (hot === box) return;
      if (hot !== null) for (const line of hot.lines) code.children[line]?.classList.remove("hot");
      hot = box;
      draw();
      if (box === null) {
        statusText.textContent = summary;
        return;
      }
      for (const line of box.lines) code.children[line]?.classList.add("hot");
      const n = box.node;
      const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(2));
      statusText.textContent =
        `left ${fmt(n.getComputedLeft())}  top ${fmt(n.getComputedTop())}  ` +
        `width ${fmt(n.getComputedWidth())}  height ${fmt(n.getComputedHeight())}`;
    }

    function update(): void {
      const source = editor.value;
      const lines = new LineIndex(source);
      setHot(null);
      let built: Box[] = [];
      let root: Node;
      let parsed;
      try {
        parsed = parse(source);
        root = build(parsed.root, 0, built, lines);
      } catch (error) {
        if (!(error instanceof ParseError)) throw error;
        parsedRoot = null;
        hideTweak();
        code.innerHTML = highlight(source, error.tokens);
        statusText.textContent = `Line ${lines.lineOf(error.offset) + 1}: ${error.message}`;
        status.classList.add("error");
        stale = true;
        draw();
        return;
      }
      parsedRoot = parsed.root;
      lineIndex = lines;
      code.innerHTML = highlight(source, parsed.tokens);
      sizer.apply(root);
      root.calculateLayout(undefined, undefined, Direction.LTR);
      boxes = built;
      boxOf = new Map(built.map((b) => [b.node, b]));
      place(built[0]!, 0, 0);
      rootSize = { width: root.getComputedWidth(), height: root.getComputedHeight() };
      stale = false;
      draw();
      summary = `${built.length} node${built.length === 1 ? "" : "s"} · root ${rootSize.width}×${rootSize.height}${sizer.note}`;
      statusText.textContent = summary;
      status.classList.remove("error");
    }

    // Caret-driven controls, as on the examples page: a slider for numbers and
    // lengths, a select for enums, editing the value under the caret in place.
    type Tweaking = { entry: StyleEntry; spec: StyleSpec };
    let tweaking: Tweaking | null = null;
    let charWidth = 0;

    function entryAt(offset: number): StyleEntry | null {
      const visit = (element: SourceElement): StyleEntry | null => {
        for (const entry of element.style) {
          if (entry.span.start <= offset && offset <= entry.span.end) return entry;
        }
        for (const child of element.children) {
          const found = visit(child);
          if (found !== null) return found;
        }
        return null;
      };
      return parsedRoot === null ? null : visit(parsedRoot);
    }
    function hideTweak(): void {
      tweak.hidden = true;
      tweaking = null;
    }
    const unitOf = (value: string | number): "px" | "%" | "auto" =>
      typeof value === "number" ? "px" : value === "auto" ? "auto" : "%";
    function configureRange(min: number, max: number, step: number, value: number, grow = true): void {
      tweakRange.min = String(Math.min(min, value));
      tweakRange.max = String(Math.max(max, grow ? Math.ceil(value * 2) : value));
      tweakRange.step = String(step);
      tweakRange.value = String(value);
      tweakNumber.min = tweakRange.min;
      tweakNumber.step = tweakRange.step;
      tweakNumber.value = String(value);
    }
    function showTweak(entry: StyleEntry): void {
      const spec = styleSpec(entry.key);
      if (spec === undefined) return hideTweak();
      const same =
        tweaking !== null && tweaking.entry.key === entry.key && tweaking.entry.valueSpan.start === entry.valueSpan.start;
      tweaking = { entry, spec };
      tweakKey.textContent = entry.key;
      const { value } = entry;
      if (spec.kind === "enum") {
        if (!same) tweakOptions.replaceChildren(...Object.keys(spec.options).map((name) => new Option(name, name)));
        tweakOptions.value = String(value);
        tweakOptions.hidden = false;
        tweakUnit.hidden = tweakRange.hidden = tweakNumber.hidden = true;
      } else if (spec.kind === "number") {
        const n = typeof value === "number" ? value : 0;
        if (!same) configureRange(spec.min, spec.max, spec.step, n);
        else tweakRange.value = tweakNumber.value = String(n);
        tweakRange.hidden = tweakNumber.hidden = false;
        tweakUnit.hidden = tweakOptions.hidden = true;
      } else {
        const unit = unitOf(value);
        tweakUnit.value = unit;
        (tweakUnit.options[2] as HTMLOptionElement).hidden = !spec.auto;
        tweakUnit.hidden = false;
        tweakOptions.hidden = true;
        if (unit === "auto") {
          tweakRange.hidden = tweakNumber.hidden = true;
        } else {
          const n = typeof value === "number" ? value : parseFloat(value);
          const percent = unit === "%";
          if (!same || tweakRange.dataset.unit !== unit) {
            configureRange(spec.negative ? (percent ? -100 : -200) : 0, percent ? 100 : 500, 1, n, !percent);
            tweakRange.dataset.unit = unit;
          } else {
            tweakRange.value = tweakNumber.value = String(n);
          }
          tweakRange.hidden = tweakNumber.hidden = false;
        }
      }
      tweak.hidden = false;
      placeTweak();
    }
    function placeTweak(): void {
      if (tweaking === null) return;
      if (charWidth === 0) {
        const probe = document.createElement("span");
        probe.textContent = "0".repeat(100);
        code.appendChild(probe);
        charWidth = probe.getBoundingClientRect().width / 100;
        probe.remove();
      }
      const style = getComputedStyle(editor);
      const lineHeight = parseFloat(style.lineHeight);
      const { start } = tweaking.entry.span;
      const line = lineIndex.lineOf(start);
      const column = start - editor.value.lastIndexOf("\n", start - 1) - 1;
      let top = parseFloat(style.paddingTop) + (line + 1) * lineHeight - editor.scrollTop + 4;
      // The pane clips at its bottom edge, so flip above the line when needed.
      if (top + tweak.offsetHeight > editor.clientHeight) {
        top = parseFloat(style.paddingTop) + line * lineHeight - editor.scrollTop - tweak.offsetHeight - 4;
      }
      const left = parseFloat(style.paddingLeft) + column * charWidth - editor.scrollLeft;
      const maxLeft = Math.max(0, editor.clientWidth - tweak.offsetWidth - 8);
      tweak.style.top = `${Math.max(4, top)}px`;
      tweak.style.left = `${Math.min(Math.max(8, left), maxLeft)}px`;
    }
    function writeValue(text: string): void {
      if (tweaking === null) return;
      const { start, end } = tweaking.entry.valueSpan;
      editor.value = editor.value.slice(0, start) + text + editor.value.slice(end);
      editor.setSelectionRange(start, start + text.length);
      update();
      const entry = entryAt(start);
      if (entry === null) hideTweak();
      else showTweak(entry);
    }
    const quoteOf = (entry: StyleEntry) => (editor.value[entry.valueSpan.start] === "'" ? "'" : '"');
    function writeNumber(text: string): void {
      if (tweaking === null || text === "" || Number.isNaN(Number(text))) return;
      const n = String(Number(text));
      if (tweaking.spec.kind === "length" && tweakUnit.value === "%") {
        const q = quoteOf(tweaking.entry);
        writeValue(`${q}${n}%${q}`);
      } else {
        writeValue(n);
      }
    }
    function onCaret(): void {
      if (document.activeElement !== editor) return;
      const entry = entryAt(editor.selectionStart);
      if (entry === null) hideTweak();
      else showTweak(entry);
    }
    tweakRange.addEventListener("input", () => writeNumber(tweakRange.value));
    tweakNumber.addEventListener("input", () => writeNumber(tweakNumber.value));
    tweakOptions.addEventListener("change", () => {
      if (tweaking === null) return;
      const q = quoteOf(tweaking.entry);
      writeValue(`${q}${tweakOptions.value}${q}`);
    });
    tweakUnit.addEventListener("change", () => {
      if (tweaking === null) return;
      const { value } = tweaking.entry;
      const n = typeof value === "number" ? value : parseFloat(value) || 0;
      const q = quoteOf(tweaking.entry);
      if (tweakUnit.value === "auto") writeValue(`${q}auto${q}`);
      else if (tweakUnit.value === "%") writeValue(`${q}${Math.min(100, Math.max(-100, n))}%${q}`);
      else writeValue(String(n));
    });
    document.addEventListener("selectionchange", onCaret);
    editor.addEventListener("keydown", (event) => {
      // Handled here, Escape closes the controls without also leaving Fill.
      if (event.key === "Escape" && !tweak.hidden) {
        hideTweak();
        event.preventDefault();
      }
    });
    // Clicking elsewhere hides the controls; clicking the controls themselves keeps them.
    editor.addEventListener("blur", (event) => {
      const next = event.relatedTarget;
      if (!(next instanceof Element && tweak.contains(next))) hideTweak();
    });

    editor.addEventListener("input", () => {
      update();
      onCaret();
    });
    editor.addEventListener("scroll", () => {
      code.parentElement!.scrollTop = editor.scrollTop;
      code.parentElement!.scrollLeft = editor.scrollLeft;
      placeTweak();
    });
    editor.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      event.preventDefault();
      editor.setRangeText("    ", editor.selectionStart, editor.selectionEnd, "end");
      update();
    });
    stage.addEventListener("mousemove", (event) => {
      const rect = stage.getBoundingClientRect();
      setHot(boxAt(event.clientX - rect.left, event.clientY - rect.top));
    });
    stage.addEventListener("mouseleave", () => setHot(null));
    const sizer = new Sizer({
      container: demo,
      preview,
      stage,
      handle: demo.querySelector<HTMLElement>(".sizer-handle")!,
      fit: demo.querySelector<HTMLButtonElement>(".sizer-fit")!,
      fill: demo.querySelector<HTMLButtonElement>(".sizer-fill")!,
      reset: demo.querySelector<HTMLButtonElement>(".sizer-reset")!,
      rootSize: () => rootSize,
      scale: () => scale,
      relayout: update,
      redraw: draw,
    });
    update();
  }

  for (const demo of document.querySelectorAll<HTMLElement>(".demo")) mount(demo);
</script>
